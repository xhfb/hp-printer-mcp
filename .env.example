HP_PRINTER_HOST=192.168.31.11
HP_PRINTER_NAME=HP Smart Tank 750
HP_SCAN_OUTPUT_DIR=./output

# IPP (network-native print)
HP_IPP_URI=ipp://192.168.31.11:631/ipp/print
HP_IPP_USERNAME=guest
HP_IPP_PASSWORD=

# HTTP clients must not use system proxy for LAN printer (avoids 502)
HP_HTTP_TRUST_ENV=false

# Remote print inputs
HP_MAX_UPLOAD_MB=25
HP_JOB_TMP_DIR=
HP_JOB_TMP_TTL_SEC=3600
HP_ALLOW_REMOTE_URL=true
HP_URL_ALLOW_RFC1918_ONLY=true

# Include base64 in scan_to_file responses for remote clients
HP_INCLUDE_SCAN_BASE64=true

# Text rasterize (TXT/MD). Prefer a CJK font to avoid □ tofu.
# Windows default search includes msyh.ttc / simhei.ttf.
# HP_PRINT_FONT=C:\Windows\Fonts\msyh.ttc
HP_PRINT_FONT_SIZE=36
